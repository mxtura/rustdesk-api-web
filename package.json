{
  "name": "rustdesk-api-web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"src/**/*.{js,ts,vue,scss}\"",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --fix",
    "*.{js,ts,vue,scss,json,md}": "prettier --write"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tanstack/vue-query": "^5.62.7",
    "@vueuse/core": "^11.3.0",
    "axios": "1.8.2",
    "clipboard": "2.0.4",
    "element-plus": "^2.8.2",
    "fast-sha256": "^1.3.0",
    "js-cookie": "^3.0.1",
    "marked": "^15.0.4",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "pinia": "2.2.8",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.7",
    "vue": "3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@intlify/unplugin-vue-i18n": "^6.0.3",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "5.2.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "qs": "^6.10.2",
    "sass": "^1.43.4",
    "ts-proto": "^1.141.1",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.5",
    "vite": "6.3.4",
    "vue-tsc": "^2.2.0"
  }
